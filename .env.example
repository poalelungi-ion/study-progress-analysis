# ==============================================================================
# Study Progress Analysis (SPA) System - Central Configuration (.env)
# ==============================================================================
# Copy this file to .env before starting the stack with:
#   docker compose up -d --build
#
# When deploying the instance on a server:
# Replace localhost / 127.0.0.1 with your server's domain name or public IP address.

# ------------------------------------------------------------------------------
# 1. CLIENT API BASE URL (Where browser makes HTTP API requests)
# ------------------------------------------------------------------------------
# The API endpoint that the client (running in users' browsers) calls to reach the backend.
# - Local development default: http://localhost:8000/api
# - Server deployment: http://<server-ip-or-domain>:8000/api
#
# NOTE: The client supports both Docker Compose build-time args and dynamic
# runtime injection via /config.js, as well as an in-browser Settings dialog
# on the login screen to test and override the target without rebuilding!
VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# 2. CORS ALLOWED ORIGINS (Backend security allowlist)
# ------------------------------------------------------------------------------
# Comma-separated allowlist of browser origins permitted to communicate with the backend.
# Because the refresh token cookie uses credentials, wildcards (*) are forbidden.
# - Local development default: http://localhost:5173,http://127.0.0.1:5173
# - Server deployment: http://<server-ip-or-domain>:5173 (or https://<server-domain>)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=spa_user
POSTGRES_PASSWORD=spa_password
POSTGRES_DB=spa_db

# ------------------------------------------------------------------------------
# 4. BACKEND AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Signing secret for JWT access and refresh tokens.
# Generate a fresh 32-byte secret for production (e.g. openssl rand -hex 32):
JWT_SECRET=insecure-development-secret-change-me

# Set COOKIE_SECURE=true when serving over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEBUG=true

# ------------------------------------------------------------------------------
# 5. INITIAL DATA SEEDING
# ------------------------------------------------------------------------------
SEED_ON_STARTUP=true
